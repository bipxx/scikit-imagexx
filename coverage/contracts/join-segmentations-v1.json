  "full_intended_contract": {
    "arguments": "s1,s2 positional or keyword; return_mapping annotated bool defaultFalse accepts Python truth protocol at LAST branch, after numerical work; preserve default/annotation/signature and exception ordering.",
    "shape": "First compare s1.shape != s2.shape with exact source ValueError f-string; plain missing-shape carriers fail before conversion. No broadcast. Arbitrary matching rank/shape includes scalar and empty behavior.",
    "validation_order": "relabel left: np.min negative check, then np.unique/in_vals[0], then dtype.kind iu check and source dtype sizing. Then same right. Final relabel runs on ACTUAL source factor product. Preserve readonly/endian/Cython buffer errors and shape-assignment warnings; do not normalize fixtures.",
    "factor": "factor=s2.max()+np.uint8(1) uses ORIGINAL right labels. It is not max(s2_relabeled)+1. NumPy1/2 scalar promotion, fixed-width factor/product wrap, float promotion, source warnings/errors and encoded collisions are contract partitions; pair equivalence is not a general oracle.",
    "labels": "Three source relabels preserve zero ONLY when present; other labels ascend by encoded sorted unique order and start1. Output dtype follows input dtype preservation, strict last<dtype.max comparison and np.min_scalar_type; j dtype need not match either input. Record intermediate factor/ranked/encoded descriptors, never infer from abstract join.",
    "returns": "Falsey flag returns owning C-order ndarray j. Truthy returns exact tuple(j,map1,map2). Source maps are skimage.util._map_array.ArrayMap, their dtype/out_values preserve left/right label descriptors and values; provider class identity is an explicit source fact.",
    "map_identity_aliases": "map1.in_values IS map2.in_values (same inverse-j.in_values ndarray); output-value arrays allocated separately; record class/module/name, cache None, max_str_lines4, keys/values descriptors, all pair/input identity+shares_memory+base topology. Do not replace identity with value equality.",
    "map_behaviour": "Existing ArrayMap contracts cover len,repr,str,dtype,call/index/slices/boolean lookup,missing0,dense __array__(dtype/copy),mutable in/out attrs,_array cache and setitem->flatnonzero compaction. Reuse those corpora; one join-specific returned-map recipe checks lookups/dense/cache mutation and shared-key alias before/after.",
    "input_and_state": "No input/pointer/shape/stride/dtype/writeability/alias mutation for ordinary cases, including errors. Preserve all warnings in order, NP error policy/handler/buffer/print options and protocol callback ordering; provider/callback/concurrent mutation remain named gates."
  },
  "source_safe_scope": "Finite nonnegative values0..7 except negative validation recipe; factor1..8 and encoded<=63 whenever integer pipeline proceeds. Uniform/mixed integer, shape/type/empty/endian/readonly error cases use equal bounded key/value and input/output lengths. Cython writable np_anyint/np_numeric views reject readonly/unsupported descriptors before unchecked loops. No short mapping arrays, forged storage, huge indices, overlap outputs, zero factor or wrap experiment.",
